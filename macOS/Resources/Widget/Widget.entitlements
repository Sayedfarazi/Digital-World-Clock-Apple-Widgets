<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read the host app's preferences (World Clock city list, click action) without an App Group:
	     the same mechanism Apple's World Clock widget uses for com.apple.clock. Works with ad-hoc signing. -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>$(APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
