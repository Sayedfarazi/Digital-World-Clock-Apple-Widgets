# Single source of truth for names, identifiers and versions.
# Sourced by every script in macOS/scripts/. Keep values free of spaces unless quoted.

APP_NAME="Digital World-Clock Widgets"    # Display name: Finder, menu bar, widget gallery section title,
                                          # release zip. Also written out in code and docs (CLAUDE.md › Name)
FORMER_APP_NAME="Digital World Clock Widgets"  # The previous name (CLAUDE.md › Name). install.sh and
                                          # uninstall.sh remove a copy installed under it (same bundle ID)
APP_EXECUTABLE="WorldClockWidgets"        # Contents/MacOS/<this>
APP_MODULE="WorldClockWidgets"            # Swift module name of the host app
APP_BUNDLE_ID="com.worldclockwidgets.app"

WIDGET_BUNDLE_NAME="ClockWidgets"         # PlugIns/<this>.appex
WIDGET_MODULE="ClockWidgets"              # Swift module name of the widget extension.
                                          # !! App Intents metadata embeds mangled type names that
                                          # !! contain this module name. Changing it requires a rebuild
                                          # !! (macOS/scripts/gen_appintents_metadata.py derives names from it).
WIDGET_BUNDLE_ID="com.worldclockwidgets.app.ClockWidgets"

URL_SCHEME="worldclockwidgets"            # Widget click -> host app -> opens Apple's Clock app

MARKETING_VERSION="1.1.1"
BUILD_NUMBER="6"
DEPLOYMENT_TARGET="26.0"                  # String parameters with a default and an option list need macOS 26 (ARCHITECTURE §5)
ARCH="arm64"

INSTALL_DIR="$HOME/Applications"
